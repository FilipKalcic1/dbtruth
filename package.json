{
  "name": "dbtruth",
  "version": "0.1.8",
  "description": "Verified database context for AI coding agents. Read-only, Postgres.",
  "license": "MIT",
  "keywords": [
    "postgres",
    "postgresql",
    "ai",
    "agent",
    "context",
    "schema",
    "database",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FilipKalcic1/dbtruth.git"
  },
  "homepage": "https://github.com/FilipKalcic1/dbtruth#readme",
  "bugs": {
    "url": "https://github.com/FilipKalcic1/dbtruth/issues"
  },
  "type": "module",
  "bin": {
    "dbtruth": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:unit": "node --import tsx --test test/acceptance.test.ts test/config.test.ts test/extract.test.ts test/model.test.ts test/schemas.test.ts test/structure.test.ts test/verdict.test.ts test/verify.test.ts test/write.test.ts",
    "test:db": "node --import tsx --test test/integration.test.ts test/safety.test.ts test/scale.test.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-prompts.mjs",
    "test:pack": "node scripts/pack-smoke.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:pack",
    "acceptance": "node scripts/acceptance.mjs",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "commander": "^15.0.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
